# Supabase projenizin ayarları (Project Settings -> API) buraya girilir.
# Bu dosyayı .env.local olarak kopyalayın; .env.local git'e eklenmez.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sadece sunucu tarafı yönetim işlemleri (kullanıcı davet etme vb.) için;
# İSTEMCİYE ASLA GÖNDERİLMEMELİDİR.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hakediş bir mühendise atanıp gönderildiğinde bildirim e-postası göndermek
# için (https://resend.com, ücretsiz plan yeterli). Tanımlı değilse e-posta
# gönderimi sessizce atlanır, hakediş kaydı yine de çalışır.
RESEND_API_KEY=
# Gönderen adresi; Resend'de doğrulanmış bir alan adınız yoksa boş bırakın,
# onboarding@resend.dev kullanılır (test için yeterli, üretimde kendi alan
# adınızı doğrulamanız önerilir).
RESEND_FROM_EMAIL=

# Uygulamanın yayınlandığı adres; e-posta içindeki "Hakedişi Görüntüle"
# linki için kullanılır. Vercel'de genelde otomatik ayarlanır (VERCEL_URL),
# özel bir domain kullanıyorsanız burada belirtin.
NEXT_PUBLIC_SITE_URL=
